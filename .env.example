# Получите у @BotFather. Секреты не коммитьте.
BOT_TOKEN=
REDIS_URL=redis://redis:6379/0

# Независимые HTTP/SOCKS5 прокси. Пустое значение = стандартное подключение.
# Например: socks5://user:password@proxy.example:1080 (пароль URL-encode).
TELEGRAM_PROXY=
MEDIA_PROXY=

# Необязательно: путь к Netscape cookies.txt, доступному worker, см. README.
COOKIES_FILE=
# Для YouTube предусмотрен Node.js + yt-dlp-ejs, уже включены в Docker.
JS_RUNTIME=node

# Обычный Telegram Bot API: максимум 50 MB, оставляем запас.
MAX_UPLOAD_MB=49
# Для собственного Telegram Bot API: задайте URL и MAX_UPLOAD_MB до 1900.
TELEGRAM_API_BASE=

# Анимация в одном сообщении с приветствием и кнопками после /start.
# Положите собственный GIF в assets/welcome.gif до сборки образа.
WELCOME_ANIMATION_PATH=assets/welcome.gif
# Необязательно: file_id анимации, уже отправленной именно этим ботом.
WELCOME_ANIMATION_FILE_ID=

MAX_DURATION_SECONDS=1800
MAX_QUEUE_SIZE=100
WORKER_CONCURRENCY=2
DOWNLOAD_FRAGMENTS=4
JOB_TIMEOUT_SECONDS=600
PROBE_TIMEOUT_SECONDS=60
# Таймаут отдельного соединения с сайтом/CDN; общий лимит задачи сохраняется.
MEDIA_SOCKET_TIMEOUT_SECONDS=20
MAX_JOBS_PER_USER_HOUR=20
LINK_COOLDOWN_SECONDS=4
SESSION_TTL_SECONDS=1800
CACHE_TTL_SECONDS=604800
DATA_DIR=/data

# polling — один экземпляр gateway; worker масштабируется отдельно.
BOT_MODE=polling
# Для webhook: публичный HTTPS URL (без /telegram), secret — 32+ случайных символа.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
